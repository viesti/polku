#!/usr/bin/env bash
# Builds a production version of the game into dist/ and copies its files to S3.
#
# Usage:
#   bin/publish s3://bucket/some/path    build, then copy each changed file under that path
#   bin/publish --build-only             build into dist/ without copying
#
# The copy runs the aws command found on PATH; set AWS_CLI to use another one. With
# aws-vault, run the whole script inside it:
#   aws-vault exec <profile> -- bin/publish s3://bucket/some/path
set -euo pipefail
cd "$(dirname "$0")/.."

target="${1:-}"
if [ -z "$target" ]; then
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
fi
if [ "$target" != "--build-only" ] && [[ "$target" != s3://* ]]; then
  echo "The target must start with s3://, for example s3://my-bucket/game" >&2
  exit 1
fi

rm -rf dist
mkdir -p dist/js dist/css

echo "Compiling the game..."
# The dev build writes to resources/public/js, so the release goes to its own folder
npx shadow-cljs release app --config-merge '{:output-dir "dist/js"}'

echo "Building the stylesheet..."
npx tailwindcss -i src/css/app.css -o dist/css/app.css --minify

# Relative paths let the game run from any folder of the bucket. The version query
# makes browsers fetch new files after each publish.
version() { shasum "$1" | cut -c1-10; }
sed -e "s|href=\"/css/app.css\"|href=\"css/app.css?v=$(version dist/css/app.css)\"|" \
    -e "s|src=\"/js/main.js\"|src=\"js/main.js?v=$(version dist/js/main.js)\"|" \
    resources/public/index.html > dist/index.html

cp -R resources/public/audio dist/audio

echo "Built into dist/: index.html js/main.js css/app.css audio/"

if [ "$target" = "--build-only" ]; then
  exit 0
fi

aws="${AWS_CLI:-aws}"
base="${target%/}"
bucket="${base#s3://}"
bucket="${bucket%%/*}"
prefix="${base#s3://$bucket}"
prefix="${prefix#/}"
prefix="${prefix:+$prefix/}"

md5_of() { openssl dgst -md5 -r "$1" | cut -d' ' -f1; }

# Prints the MD5 of the object already at `key`, or nothing when it is missing. A
# multipart upload's ETag is not an MD5, so the md5 metadata this script writes wins.
remote_md5() {
  local out etag meta
  out=$($aws s3api head-object --bucket "$bucket" --key "$1" \
          --query '[ETag, Metadata.md5]' --output text 2>/dev/null) || return 0
  etag=$(printf '%s' "$out" | cut -f1 | tr -d '"')
  meta=$(printf '%s' "$out" | cut -f2)
  if [ -n "$meta" ] && [ "$meta" != "None" ]; then
    echo "$meta"
  elif [[ "$etag" != *-* ]]; then
    echo "$etag"
  fi
}

upload() {
  local file="$1" type="$2" cache="$3" sum
  sum=$(md5_of "dist/$file")
  if [ -n "$sum" ] && [ "$(remote_md5 "$prefix$file")" = "$sum" ]; then
    echo "Unchanged $file"
    return
  fi
  echo "Copying $file to $base/$file"
  $aws s3 cp "dist/$file" "$base/$file" --content-type "$type" --cache-control "$cache" \
    --metadata "md5=$sum"
}
upload js/main.js "application/javascript; charset=utf-8" "public, max-age=31536000"
upload css/app.css "text/css; charset=utf-8" "public, max-age=31536000"
for f in dist/audio/*; do
  name="audio/$(basename "$f")"
  case "$f" in
    *.ogg) upload "$name" "audio/ogg" "public, max-age=86400" ;;
    *.m4a) upload "$name" "audio/mp4" "public, max-age=86400" ;;
  esac
done
# index.html goes last so it never points at files that are not there yet
upload index.html "text/html; charset=utf-8" "no-cache"

echo "Published to $base/index.html"
