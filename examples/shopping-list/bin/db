#!/usr/bin/env bash
# Controls the demo's PostgreSQL container, which listens on localhost:5433.
set -euo pipefail
cd "$(dirname "$0")/.."

# Stops the database of another Polku app (the demo or an example) that holds
# the port, since they all use 5433. Any other program on the port is left alone.
free_port() {
  local here name dir
  here="$(pwd -P)"
  docker ps --filter publish=5433 \
    --format '{{.Names}}|{{.Label "com.docker.compose.project.working_dir"}}' |
    while IFS='|' read -r name dir; do
      if [ "$dir" = "$here" ]; then
        continue
      elif [ -x "$dir/bin/db" ] && [ -f "$dir/.claude/skills/polku/SKILL.md" ]; then
        echo "Stopping the database of $dir, which holds port 5433"
        (cd "$dir" && docker compose stop db)
      else
        echo "Port 5433 is in use by container $name; stop it and try again" >&2
        exit 1
      fi
    done
}

case "${1:-start}" in
  start)
    free_port
    docker compose up -d --wait db
    echo "PostgreSQL running on localhost:5433, database demo"
    ;;
  stop)
    docker compose stop db
    ;;
  psql)
    shift
    exec docker compose exec db psql -U demo demo "$@"
    ;;
  *)
    echo "usage: bin/db [start|stop|psql]" >&2
    exit 1
    ;;
esac
